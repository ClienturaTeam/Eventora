generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  passwordHash          String
  firstName             String?
  lastName              String?
  status                UserStatus           @default(PENDING)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  aiRequestsMade        AIRequest[]          @relation("AIRequester")
  apiKeysCreated        ApiKey[]             @relation("ApiKeyCreator")
  attendanceRecords     AttendanceRecord[]
  auditLogs             AuditLog[]
  badgesAwarded         BadgeAward[]         @relation("BadgeAwarder")
  badgesReceived        BadgeAward[]         @relation("BadgeRecipient")
  Certificate           Certificate[]
  communicationsCreated Communication[]
  coursesInstructed     Course[]             @relation("CourseInstructor")
  courseEnrollments     CourseEnrollment[]   @relation("CourseParticipant")
  discussionsAuthored   Discussion[]         @relation("DiscussionAuthor")
  discussionReplies     DiscussionReply[]    @relation("ReplyAuthor")
  communityGroups       GroupMembership[]    @relation("GroupMember")
  integrationsConnected Integration[]        @relation("IntegrationConnector")
  jobApplications       JobApplication[]     @relation("JobCandidate")
  resourcesUploaded     LearningResource[]   @relation("ResourceUploader")
  mentorProfile         Mentor?
  notifications         Notification[]       @relation("NotificationRecipient")
  memberships           OrganizationMember[]
  registrations         Registration[]
  securityEvents        SecurityEvent[]
  surveyResponses       SurveyResponse[]     @relation("SurveyParticipant")
  teamMembers           TeamMember[]
  mfa                   UserMfa?
  recoveryCodes         UserRecoveryCode[]
  sessions              UserSession[]
  volunteerProfile      Volunteer?
  winnersSelected       Winner[]             @relation("WinnerSelector")
  winningEntries        Winner[]
  workflowsCreated      Workflow[]           @relation("WorkflowCreator")
  workshopsInstructed   Workshop[]           @relation("WorkshopInstructor")
  payments              Payment[]            @relation("UserPayments")
  AIInsightsReport      AIInsightsReport[]
  eventTeamAssignments  EventTeamMember[]
  submittedProposals    HackathonProposal[]  @relation("ProposalSubmitter")
  managedProposals      HackathonProposal[]  @relation("ProposalManager")
  principalProposals    HackathonProposal[]  @relation("ProposalPrincipal")
  EventFinalReport      EventFinalReport[]
  facultyReports        EventFinalReport[]   @relation("ReportFaculty")
  managerReports        EventFinalReport[]   @relation("ReportManager")
  submittedSubmissions  Submission[]         @relation("SubmissionSubmitter")
  judgeAssignments      SubmissionJudgeAssignment[]
  askedQuestions        MentorQuestion[]     @relation("QuestionParticipant")
  mentoredQuestions     MentorQuestion[]     @relation("QuestionMentor")
  questionReplies       QuestionReply[]
  judgeProfiles         Judge[]
}

model Organization {
  id                  String                      @id @default(uuid())
  name                String
  slug                String                      @unique
  status              OrganizationStatus          @default(PENDING)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  aiRequests          AIRequest[]
  aiValidationRecords AIValidationRecord[]
  achievements        Achievement[]
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  badges              Badge[]
  badgeAwards         BadgeAward[]
  Certificate         Certificate[]
  communications      Communication[]
  communityGroups     CommunityGroup[]
  coupons             Coupon[]
  courses             Course[]
  discussions         Discussion[]
  events              Event[]
  integrations        Integration[]
  invoices            Invoice[]
  jobPostings         JobPosting[]
  judges              Judge[]
  learningResources   LearningResource[]
  mentors             Mentor[]
  notifications       Notification[]
  billingProfile      OrganizationBillingProfile?
  members             OrganizationMember[]
  securityPolicies    OrganizationSecurityPolicy?
  payments            Payment[]
  prizes              Prize[]
  refunds             Refund[]
  roles               Role[]
  securityEvents      SecurityEvent[]
  sponsors            Sponsor[]
  subscriptions       Subscription?
  surveys             Survey[]
  userSessions        UserSession[]
  volunteers          Volunteer[]
  webhooks            Webhook[]
  winners             Winner[]
  workflows           Workflow[]
  workshops           Workshop[]
  AIInsightsReport    AIInsightsReport[]
  hackathonProposals  HackathonProposal[]
  EventFinalReport    EventFinalReport[]
  problemStatements   ProblemStatement[]
  mentorQuestions     MentorQuestion[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  status         MemberStatus @default(INVITED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Role {
  id             String               @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  members        OrganizationMember[]
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]

  @@unique([name, organizationId])
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Event {
  id                 String              @id @default(uuid())
  organizationId     String
  name               String
  description        String?
  rules              String?
  status             EventStatus         @default(DRAFT)
  startTime          DateTime
  endTime            DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendanceSessions AttendanceSession[]
  Certificate        Certificate[]
  competitions       Competition[]
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrations      Registration[]
  sponsorships       Sponsorship[]
  surveys            Survey[]
  volunteerEvents    VolunteerEvent[]
  price              Decimal             @default(0) @db.Decimal(12, 2)
  currency           String              @default("INR")
  revenue            Decimal             @default(0) @db.Decimal(12, 2)
  payments           Payment[]           @relation("EventPayments")
  AIInsightsReport   AIInsightsReport[]
  proposalId         String?             @unique
  proposal           HackathonProposal?  @relation(fields: [proposalId], references: [id])
  teamMembers        EventTeamMember[]
  EventFinalReport   EventFinalReport?
  rounds             EventRound[]
  mentorQuestions    MentorQuestion[]
  submissions        Submission[]
  problemStatements  ProblemStatement[]

  // Registration Configuration
  registrationType   RegistrationType @default(INDIVIDUAL)
  minTeamSize        Int?
  maxTeamSize        Int?
  registrationStart  DateTime?
  registrationEnd    DateTime?
  registrationConfig Json?
}

model Competition {
  id               String             @id @default(uuid())
  eventId          String
  name             String
  description      String?
  rubric           Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Certificate      Certificate[]
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judgeAssignments JudgeCompetition[]
  prizes           Prize[]
  submissions      Submission[]
  teams            Team[]
  winners          Winner[]
}

model Registration {
  id        String             @id @default(uuid())
  eventId   String
  userId    String
  status    RegistrationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment   Payment?           @relation("RegistrationPayment")

  @@unique([eventId, userId])
}

model Team {
  id                         String            @id @default(uuid())
  competitionId              String
  name                       String
  size                       Int               @default(1)
  problemStatementId         String?
  problemStatementLocked     Boolean           @default(false)
  problemStatementSelectedAt DateTime?
  currentRound               Int               @default(1)
  round1Status               String?           @default("PENDING")
  round2Status               String?           @default("LOCKED")
  round3Status               String?           @default("LOCKED")
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  submissions                Submission[]
  competition                Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  problemStatement            ProblemStatement? @relation(fields: [problemStatementId], references: [id])
  members                    TeamMember[]
  invitations                TeamInvitation[]
  mentorAssignments          TeamMentor[]
  winners                    Winner[]
}

model TeamMember {
  id            String   @id @default(uuid())
  teamId        String
  userId        String?
  name          String?
  email         String?
  contactNumber String?
  college       String?
  department    String?
  year          String?
  isLead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProblemStatement {
  id               String       @id @default(uuid())
  organizationId   String
  eventId          String?
  code             String
  title            String
  description      String
  category         String?
  isReleased       Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event            Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teams            Team[]
  applicableRounds EventRound[]
  submissions      Submission[]
}

model TeamInvitation {
  id        String           @id @default(uuid())
  teamId    String
  email     String
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
}

model Submission {
  id                 String                      @id @default(uuid())
  eventId            String?
  teamId             String
  competitionId      String
  roundId            String?
  roundNumber        Int                         @default(1)
  submittedById      String?
  title              String
  payload            Json?
  status             SubmissionStatus            @default(DRAFT)
  isLocked           Boolean                     @default(false)
  lockedAt           DateTime?
  problemStatementId String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  aiValidationRecord AIValidationRecord?
  evaluations        Evaluation[]
  competition        Competition                 @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team               Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event              Event?                      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventRound         EventRound?                 @relation(fields: [roundId], references: [id], onDelete: SetNull)
  problemStatement   ProblemStatement?           @relation(fields: [problemStatementId], references: [id], onDelete: SetNull)
  submittedBy        User?                       @relation("SubmissionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  judgeAssignments   SubmissionJudgeAssignment[]
  files              SubmissionFile[]
  winners            Winner[]
}

model SubmissionFile {
  id           String     @id @default(uuid())
  submissionId String
  fileName     String
  fileUrl      String
  fileSize     Int
  fileType     String
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Judge {
  id             String             @id @default(uuid())
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String             @default("Unknown Judge")
  email          String             @default("unknown@example.com")
  organizationId String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  bio            String?
  expertise      String?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  competitions   JudgeCompetition[]
  evaluations    Evaluation[]
}

model JudgeCompetition {
  id            String      @id @default(uuid())
  judgeId       String
  competitionId String
  assignedAt    DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  judge         Judge       @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([judgeId, competitionId])
  @@index([competitionId])
}

model Evaluation {
  id               String           @id @default(uuid())
  submissionId     String
  judgeId          String
  roundId          String?
  score            Float?
  feedback         String?
  recommendation   String?
  criteriaScores   Json?
  isLocked         Boolean          @default(false)
  lockedAt         DateTime?
  correctionReason String?
  roundNumber      Int              @default(1)
  status           EvaluationStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  judge        Judge            @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  eventRound       EventRound?      @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@unique([submissionId, judgeId])
}

model Mentor {
  id              String       @id @default(uuid())
  userId          String       @unique
  organizationId  String
  expertise       String?
  bio             String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamAssignments TeamMentor[]
}

model TeamMentor {
  id         String   @id @default(uuid())
  mentorId   String
  teamId     String
  assignedAt DateTime @default(now())
  mentor     Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([mentorId, teamId])
  @@index([teamId])
}

model Volunteer {
  id               String           @id @default(uuid())
  userId           String           @unique
  organizationId   String
  role             String?
  bio              String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventAssignments VolunteerEvent[]
}

model VolunteerEvent {
  id          String    @id @default(uuid())
  volunteerId String
  eventId     String
  shiftsCount Int       @default(0)
  hoursCount  Float     @default(0)
  assignedAt  DateTime  @default(now())
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, eventId])
  @@index([eventId])
}

model AttendanceSession {
  id          String             @id @default(uuid())
  eventId     String
  name        String
  description String?
  startTime   DateTime
  endTime     DateTime
  status      SessionStatus      @default(UPCOMING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  records     AttendanceRecord[]
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id           String            @id @default(uuid())
  sessionId    String
  userId       String
  checkInTime  DateTime          @default(now())
  checkOutTime DateTime?
  method       AttendanceMethod  @default(MANUAL)
  status       AttendanceStatus  @default(PRESENT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

model Certificate {
  id                String            @id @default(uuid())
  userId            String
  organizationId    String
  title             String
  issuedAt          DateTime          @default(now())
  metadata          Json?
  certificateNumber String            @unique
  competitionId     String?
  teamId            String?
  recipientName     String?
  teamName          String?
  awardTitle        String?
  createdAt         DateTime          @default(now())
  description       String?
  eventId           String
  expiryDate        DateTime?
  status            CertificateStatus @default(ISSUED)
  type              CertificateType
  updatedAt         DateTime          @updatedAt
  verificationCode  String            @unique
  competition       Competition?      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, type])
  @@index([organizationId])
  @@index([userId])
  @@index([eventId])
  @@index([competitionId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String
  action         String
  target         String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([actorId])
}

model Communication {
  id             String              @id @default(uuid())
  organizationId String
  title          String
  content        String
  type           CommunicationType   @default(ANNOUNCEMENT)
  status         CommunicationStatus @default(DRAFT)
  audience       String
  scheduledAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      String
  creator        User                @relation(fields: [createdBy], references: [id])
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Notification {
  id              String           @id @default(uuid())
  organizationId  String
  recipientUserId String
  title           String
  message         String
  type            NotificationType @default(SYSTEM)
  isRead          Boolean          @default(false)
  readAt          DateTime?
  link            String?
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient       User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
}

model Prize {
  id             String       @id @default(uuid())
  organizationId String
  competitionId  String
  teamId         String?
  resultType     String?
  name           String
  position       String
  value          Decimal?     @db.Decimal(12, 2)
  amount         Decimal?     @db.Decimal(12, 2)
  currency       String?
  description    String?
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  competition    Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  winners        Winner[]
}

model Winner {
  id             String       @id @default(uuid())
  organizationId String
  competitionId  String
  submissionId   String
  teamId         String?
  userId         String?
  position       String
  status         String       @default("PENDING")
  prizeId        String?
  selectedBy     String
  selectedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  competition    Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prize          Prize?       @relation(fields: [prizeId], references: [id])
  selector       User         @relation("WinnerSelector", fields: [selectedBy], references: [id])
  submission     Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, submissionId])
}

model Badge {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  icon           String?
  type           String
  criteria       String?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  awards         BadgeAward[]
}

model BadgeAward {
  id              String       @id @default(uuid())
  organizationId  String
  badgeId         String
  recipientUserId String
  reason          String?
  awardedBy       String?
  awardedAt       DateTime     @default(now())
  revokedAt       DateTime?
  awarder         User?        @relation("BadgeAwarder", fields: [awardedBy], references: [id])
  badge           Badge        @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient       User         @relation("BadgeRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([badgeId, recipientUserId])
  @@index([organizationId])
  @@index([recipientUserId])
}

model Achievement {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  criteria       String
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Course {
  id             String             @id @default(uuid())
  organizationId String
  title          String
  category       String
  instructorId   String
  level          String
  status         String             @default("DRAFT")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  instructor     User               @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments    CourseEnrollment[]
}

model CourseEnrollment {
  id         String   @id @default(uuid())
  courseId   String
  userId     String
  status     String   @default("ENROLLED")
  progress   Int      @default(0)
  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation("CourseParticipant", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model LearningResource {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  type           String
  category       String
  downloads      Int          @default(0)
  url            String?
  status         String       @default("ACTIVE")
  uploadedById   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
}

model Workshop {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  instructorId   String
  date           DateTime
  duration       String
  status         String       @default("UPCOMING")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  instructor     User         @relation("WorkshopInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CommunityGroup {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  category       String
  status         String            @default("ACTIVE")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        GroupMembership[]
}

model GroupMembership {
  id       String         @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime       @default(now())
  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User           @relation("GroupMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Discussion {
  id             String            @id @default(uuid())
  organizationId String
  title          String
  category       String
  status         String            @default("OPEN")
  views          Int               @default(0)
  likes          Int               @default(0)
  authorId       String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  author         User              @relation("DiscussionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  replies        DiscussionReply[]
}

model DiscussionReply {
  id           String     @id @default(uuid())
  discussionId String
  authorId     String
  content      String
  likes        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  author       User       @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
}

model Survey {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  eventId        String?
  audience       String
  status         String           @default("DRAFT")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  event          Event?           @relation(fields: [eventId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questions      SurveyQuestion[]
  responses      SurveyResponse[]
}

model SurveyQuestion {
  id       String @id @default(uuid())
  surveyId String
  text     String
  type     String
  order    Int    @default(0)
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model SurveyResponse {
  id            String   @id @default(uuid())
  surveyId      String
  participantId String
  sentiment     String?
  rating        Int?
  comments      String?
  createdAt     DateTime @default(now())
  participant   User     @relation("SurveyParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  survey        Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model JobPosting {
  id             String           @id @default(uuid())
  organizationId String
  title          String
  company        String
  roleType       String
  status         String           @default("OPEN")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model JobApplication {
  id          String     @id @default(uuid())
  jobId       String
  candidateId String
  stage       String     @default("APPLIED")
  score       Float?
  source      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  candidate   User       @relation("JobCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Sponsor {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  tier           String
  committedValue Decimal?     @db.Decimal(12, 2)
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  renewalDate    DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       SponsorContact[]
  sponsorships   Sponsorship[]

  @@index([organizationId])
}

model SponsorContact {
  id        String  @id @default(uuid())
  sponsorId String
  name      String
  email     String
  role      String?
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
}

model Sponsorship {
  id                 String   @id @default(uuid())
  sponsorId          String
  eventId            String
  deliverablesMet    Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deliverablesTarget Int      @default(0)
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsor            Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
}

model Workflow {
  id             String              @id @default(uuid())
  organizationId String
  name           String
  trigger        String
  actions        String[]
  status         String              @default("Draft")
  lastRun        DateTime?
  executions     Int                 @default(0)
  successRate    Float               @default(0.0)
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      User                @relation("WorkflowCreator", fields: [createdById], references: [id], onDelete: Cascade)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowExecs  WorkflowExecution[]
}

model WorkflowExecution {
  id           String    @id @default(uuid())
  workflowId   String
  triggerEvent String
  started      DateTime  @default(now())
  completed    DateTime?
  durationMs   Int?
  status       String    @default("Running")
  error        String?
  workflow     Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String
  description String
  trigger     String
  actionCount Int      @default(0)
  category    String
  createdAt   DateTime @default(now())
}

model Integration {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  category       String
  description    String?
  status         String       @default("Disconnected")
  logo           String?
  connectedById  String?
  connectedDate  DateTime?
  lastSync       DateTime?
  apiUsage       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  connectedBy    User?        @relation("IntegrationConnector", fields: [connectedById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  environment    String
  keyHash        String
  maskedKey      String
  createdById    String
  lastUsed       DateTime?
  status         String       @default("Active")
  expiry         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User         @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Webhook {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  endpoint       String
  events         String[]
  status         String            @default("Active")
  lastDelivery   DateTime?
  successRate    Float             @default(0.0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]
}

model WebhookDelivery {
  id           String   @id @default(uuid())
  webhookId    String
  event        String
  status       String
  responseCode Int?
  durationMs   Int?
  createdAt    DateTime @default(now())
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

model AIValidationRecord {
  id              String       @id @default(uuid())
  organizationId  String
  submissionId    String       @unique
  status          String       @default("pending")
  plagiarismScore Float        @default(0.0)
  aiContentScore  Float        @default(0.0)
  duplicateScore  Float        @default(0.0)
  codeQuality     Float        @default(0.0)
  grammarScore    Float        @default(0.0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission      Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model AIRequest {
  id             String       @id @default(uuid())
  organizationId String
  feature        String
  tokens         Int          @default(0)
  durationMs     Int          @default(0)
  status         String       @default("Success")
  requestedById  String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User         @relation("AIRequester", fields: [requestedById], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id              String         @id @default(uuid())
  name            String
  description     String?
  stripeProductId String?        @unique
  stripePriceId   String?        @unique
  price           Decimal        @db.Decimal(12, 2)
  currency        String         @default("INR")
  interval        String         @default("month")
  features        Json?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model OrganizationBillingProfile {
  id               String       @id @default(uuid())
  organizationId   String       @unique
  email            String?
  phone            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  taxId            String?
  stripeCustomerId String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(INACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  provider           PaymentProvider
  providerSubId      String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
}

model Payment {
  id                String          @id @default(uuid())
  organizationId    String
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider
  providerPaymentId String?         @unique
  description       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  invoice           Invoice?
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  refunds           Refund[]
  type              PaymentType     @default(SUBSCRIPTION)
  userId            String?
  eventId           String?
  registrationId    String?         @unique

  user         User?         @relation("UserPayments", fields: [userId], references: [id], onDelete: SetNull)
  event        Event?        @relation("EventPayments", fields: [eventId], references: [id], onDelete: SetNull)
  registration Registration? @relation("RegistrationPayment", fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([eventId])
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  paymentId      String        @unique
  invoiceNumber  String        @unique
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  currency       String
  status         InvoiceStatus @default(DRAFT)
  issuedAt       DateTime?
  paidAt         DateTime?
  invoiceUrl     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model Coupon {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  type           CouponType   @default(PERCENTAGE)
  value          Decimal      @db.Decimal(12, 2)
  isActive       Boolean      @default(true)
  maxUses        Int?
  usedCount      Int          @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Refund {
  id               String        @id @default(uuid())
  organizationId   String
  paymentId        String
  amount           Decimal       @db.Decimal(12, 2)
  reason           String?
  status           PaymentStatus
  providerRefundId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([paymentId])
}

model PaymentWebhookEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  providerEventId String          @unique
  eventType       String
  status          String
  processedAt     DateTime?
  failureReason   String?
  payload         Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model UserSession {
  id              String        @id @default(uuid())
  userId          String
  organizationId  String?
  tokenIdentifier String        @unique
  ipAddress       String?
  userAgent       String?
  device          String?
  loginTime       DateTime      @default(now())
  lastActivityAt  DateTime      @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([tokenIdentifier, expiresAt])
}

model OrganizationSecurityPolicy {
  id                   String       @id @default(uuid())
  organizationId       String       @unique
  mfaEnabled           Boolean      @default(false)
  mfaRequiredForAdmins Boolean      @default(false)
  minPasswordLength    Int          @default(12)
  passwordExpiryDays   Int          @default(90)
  lockoutThreshold     Int          @default(5)
  ssoEnabled           Boolean      @default(false)
  ssoProvider          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SecurityEvent {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  event          String
  severity       String
  ipAddress      String?
  device         String?
  status         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
}

model UserMfa {
  id         String    @id @default(uuid())
  userId     String    @unique
  secret     String
  enabled    Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

