model AIInsightsReport {
  id              String       @id @default(uuid())
  organizationId  String
  eventId         String?
  generatedById   String
  title           String
  metricsSnapshot Json
  report          Json
  model           String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  event           Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  generatedBy     User         @relation(fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([eventId])
  @@index([generatedById])
}

enum ProposalStatus {
  DRAFT
  SUBMITTED_TO_MANAGER
  MANAGER_APPROVED
  MANAGER_REJECTED
  CHANGES_REQUESTED
  SUBMITTED_TO_PRINCIPAL
  PRINCIPAL_APPROVED
  PRINCIPAL_REJECTED
  EVENT_CREATED
}

model HackathonProposal {
  id                    String         @id @default(uuid())
  organizationId        String
  title                 String
  description           String?
  expectedParticipants  Int?
  estimatedBudget       Decimal?       @db.Decimal(12, 2)
  requiredManpower      Int?
  estimatedWorkingHours Float?
  startDate             DateTime?
  endDate               DateTime?
  requirements          String?
  status                ProposalStatus @default(DRAFT)
  submittedById         String
  managerId             String?
  managerComment        String?
  managerReviewedAt     DateTime?
  principalId           String?
  principalComment      String?
  principalReviewedAt   DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy  User         @relation("ProposalSubmitter", fields: [submittedById], references: [id])
  manager      User?        @relation("ProposalManager", fields: [managerId], references: [id])
  principal    User?        @relation("ProposalPrincipal", fields: [principalId], references: [id])
  event        Event?

  @@index([organizationId])
  @@index([submittedById])
  @@index([managerId])
  @@index([principalId])
  @@index([status])
}

model EventTeamMember {
  id             String   @id @default(uuid())
  eventId        String
  userId         String
  responsibility String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

enum ReportStatus {
  DRAFT
  AI_GENERATED
  SUBMITTED_TO_FACULTY
  CHANGES_REQUESTED_BY_FACULTY
  SUBMITTED_TO_MANAGER
  CHANGES_REQUESTED_BY_MANAGER
  APPROVED
  FINALIZED
}

model EventFinalReport {
  id             String @id @default(uuid())
  eventId        String @unique
  organizationId String
  coordinatorId  String

  executiveSummary  String?
  eventOutcome      String?
  keyHighlights     String?
  challenges        String?
  recommendations   String?
  additionalRemarks String?

  supportingDocuments Json?

  aiGeneratedContent String?
  finalizedContent   String?

  facultyId         String?
  facultyComment    String?
  facultyReviewedAt DateTime?
  managerId         String?
  managerComment    String?
  managerReviewedAt DateTime?

  status ReportStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coordinator  User         @relation(fields: [coordinatorId], references: [id])
  faculty      User?        @relation("ReportFaculty", fields: [facultyId], references: [id])
  manager      User?        @relation("ReportManager", fields: [managerId], references: [id])

  @@index([organizationId])
  @@index([eventId])
  @@index([coordinatorId])
  @@index([facultyId])
  @@index([managerId])
}

model EventRound {
  id                 String           @id @default(uuid())
  eventId            String
  roundNumber        Int
  name               String
  description        String?
  maxMarks           Float            @default(100)
  submissionStart    DateTime?
  submissionDeadline DateTime?
  status             String           @default("ACTIVE")
  instructions       String?
  submissionType     String?          @default("FILE")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  event              Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissions        Submission[]
  evaluations        Evaluation[]
  mentorQuestions    MentorQuestion[]
  problemStatements  ProblemStatement[]

  @@unique([eventId, roundNumber])
}

model SubmissionJudgeAssignment {
  id           String     @id @default(uuid())
  submissionId String
  judgeId      String
  assignedAt   DateTime   @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge        User       @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([submissionId, judgeId])
}

model MentorQuestion {
  id             String          @id @default(uuid())
  organizationId String
  eventId        String
  roundId        String?
  participantId  String
  mentorId       String?
  subject        String
  question       String
  status         String          @default("OPEN")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round          EventRound?     @relation(fields: [roundId], references: [id], onDelete: SetNull)
  participant    User            @relation("QuestionParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  mentor         User?           @relation("QuestionMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  replies        QuestionReply[]
}

model QuestionReply {
  id         String         @id @default(uuid())
  questionId String
  senderId   String
  message    String
  createdAt  DateTime       @default(now())

  question   MentorQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sender     User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
